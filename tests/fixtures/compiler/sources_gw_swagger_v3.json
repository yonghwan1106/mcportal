{
  "openapi": "3.1.0",
  "info": {
    "title": "가상 재난문자 알림 서비스",
    "description": "합성 픽스처(가상 기관 · .invalid 도메인).",
    "version": "2.0"
  },
  "servers": [
    {"url": "https://apis.example.invalid/0000001/alertService/"}
  ],
  "paths": {
    "/getAlertList": {
      "get": {
        "operationId": "getAlertList",
        "summary": "재난문자 목록 조회",
        "description": "가상 재난문자 목록을 돌려준다.",
        "tags": ["alert", "list"],
        "deprecated": true,
        "parameters": [
          {
            "name": "serviceKey",
            "in": "query",
            "required": true,
            "description": "인증키(어댑터가 제거해야 한다)",
            "schema": {"type": "string"}
          },
          {
            "name": "pageNo",
            "in": "query",
            "required": true,
            "description": "페이지 번호",
            "example": "1",
            "schema": {"type": "integer", "default": 1}
          },
          {
            "name": "numOfRows",
            "in": "query",
            "required": false,
            "schema": {"type": "integer"}
          },
          {
            "name": "regionCodes",
            "in": "query",
            "required": false,
            "description": "지역 코드 목록",
            "schema": {"type": "array", "items": {"type": "integer"}}
          },
          {
            "name": "X-Request-Trace",
            "in": "header",
            "required": false,
            "description": "추적 헤더",
            "schema": {"type": "string"}
          },
          {
            "name": "sessionHint",
            "in": "cookie",
            "required": false,
            "description": "W2 미지원 위치(cookie). 조용히 버려져야 한다.",
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "정상",
            "content": {
              "text/xml": {"schema": {"type": "object"}},
              "application/json": {
                "schema": {"$ref": "#/components/schemas/AlertPage"}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AlertPage": {
        "type": "object",
        "properties": {
          "items": {"type": "array", "items": {"type": "string"}},
          "totalCount": {"type": "integer"}
        }
      }
    }
  }
}
