  "paths": {
    "/admrulSearchList.do": {
      "get": {
        "description": "훈령·예규·고시·지침 등 행정규칙을 찾는다. 행정규칙은 국회가 만든 법률이나 정부가 만든 시행령이 아니라 행정기관이 소관 업무를 처리하려고 정한 규범이다. 법률·시행령·시행규칙을 찾을 때는 법령 검색을 쓴다.\n\n예시 프롬프트:\n- 식품 표시 관련 고시가 뭐가 있는지 찾아줘\n- 고용노동부 훈령 목록 보여줘",
        "operationId": "admrulSearchList",
        "parameters": [
          {
            "description": "한 페이지에 담을 결과 수. 1~100 범위를 권장한다. 응답 메시지 크기 상한(4,000 byte)이 있으므로 크게 잡으면 잘릴 수 있다.",
            "example": 10,
            "in": "query",
            "name": "numOfRows",
            "required": true,
            "schema": {
              "examples": [
                10
              ],
              "type": "integer"
            }
          },
          {
            "description": "페이지 번호. 1부터 시작한다.",
            "example": 1,
            "in": "query",
            "name": "pageNo",
            "required": true,
            "schema": {
              "examples": [
                1
              ],
              "type": "integer"
            }
