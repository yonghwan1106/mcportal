  "paths": {
    "/getNewtradeList": {
      "get": {
        "description": "월 범위로 우리나라 전체의 수출·수입 건수와 금액, 무역수지를 조회한다. 국가 구분이 없는 총계이며 응답 항목은 기간·수출건수·수출금액·수입건수·수입금액·무역수지다. 특정 국가와의 실적이나 국가별 순위가 필요하면 국가별 수출입실적 조회 도구를 쓴다.\n\n예시 프롬프트:\n- 2016년 1월 우리나라 전체 수출입 실적 알려줘\n- 2015년 한 해 월별 무역수지 추이를 정리해줘",
        "operationId": "getNewtradeList",
        "parameters": [
          {
            "description": "조회 종료 연월. YYYYMM 6자리. 시작 연월보다 앞선 값을 넣으면 안 된다.",
            "example": "201601",
            "in": "query",
            "name": "endYymm",
            "required": true,
            "schema": {
              "examples": [
                "201601"
              ],
              "type": "string"
            }
          },
          {
            "description": "조회 시작 연월. YYYYMM 6자리로 넣는다(예: 201601). 종료 연월과 같은 값이어도 된다.",
            "example": "201601",
            "in": "query",
            "name": "strtYymm",
            "required": true,
            "schema": {
              "examples": [
                "201601"
              ],
